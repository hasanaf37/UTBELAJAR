# ==============================================================================
# KONFIGURASI SUPABASE UTBELAJAR
# Salin file ini menjadi konfigurasi proyek Anda
# ==============================================================================

# Supabase Project URL (Dapatkan dari Project Settings > API di dashboard Supabase)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Public Key aman untuk frontend browser)
SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Edge Function AI Chatbot (Opsional - disetel di Supabase Dashboard Secrets)
# GEMINI_API_KEY=AIzaSy...
# Atau
# OPENAI_API_KEY=sk-...
